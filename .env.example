# Copy to .env and change every "change-me" value before the first start.

CLINIC_NAME=Klinik Sehat
# Puskesmas the monthly DM/HT report (menu Laporan) goes to; pre-filled in its title, can be changed there.
PUSKESMAS_NAME=

# Header of the printed patient card (Kartu periksa): practice name (default CLINIC_NAME),
# address line, WhatsApp number (shown next to a WhatsApp logo). Leave a line empty to omit it.
KARTU_NAMA=dr. Andi Pratama
KARTU_ALAMAT=Jl. Melati No. 1 Solo, 57100 - Telp. (0271) 000 000
KARTU_WA=0812 0000 0000

# Long random string, e.g. output of:  openssl rand -base64 48
DJANGO_SECRET_KEY=change-me
# Comma-separated host names / IPs the app is reached on. "*" accepts any (fine on a closed LAN).
DJANGO_ALLOWED_HOSTS=*

# HTTPS through the bundled Caddy (needed for the webcam; see README, "HTTPS"). Uncomment all three:
# EMR_HOST = every address people type, comma-separated: the server's name and/or its fixed LAN IP
# (or a domain). EMR_TLS = "internal" (Caddy's own certificate, for a LAN) or your email address
# (free Let's Encrypt certificate, for a domain reachable from the internet).
# COMPOSE_PROFILES=https
# EMR_HOST=serverkliniksehat, 192.168.1.10
# EMR_TLS=internal

# Only for your own reverse proxy instead of the bundled Caddy (EMR_HOST sets both by itself):
# set to 1 when it serves the app over HTTPS, and give its public origin, e.g. https://emr.klinik-sehat.id
DJANGO_HTTPS=0
# DJANGO_CSRF_TRUSTED_ORIGINS=

TIME_ZONE=Asia/Jakarta

POSTGRES_DB=emr
POSTGRES_USER=emr
POSTGRES_PASSWORD=change-me

# First admin account, created on first start only.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Port users open in the browser (http://<server-ip>:WEB_PORT). Inside the container the app
# always listens on 8000, so `docker ps` shows e.g. 0.0.0.0:8765->8000/tcp — that is correct.
WEB_PORT=8000

# Password rules for staff accounts, checked when a password is set in the app.
# Minimum length (0 = no minimum):
PASSWORD_MIN_LENGTH=8
# 1 = reject, 0 = allow: very common passwords (password123, qwerty...), digits-only
# passwords, and passwords too close to the username / display name.
PASSWORD_BLOCK_COMMON=1
PASSWORD_BLOCK_ALL_NUMERIC=1
PASSWORD_BLOCK_SIMILAR_TO_NAME=1
# 1 = required, 0 = not required: a digit, a capital letter, a symbol such as ! @ # -
PASSWORD_REQUIRE_DIGIT=0
PASSWORD_REQUIRE_UPPERCASE=0
PASSWORD_REQUIRE_SYMBOL=0

# Address phones use to open the "Upload via HP" QR link, if it differs from the
# address the desktop browser uses, e.g. http://192.168.1.10:8000. With EMR_HOST it defaults to
# https:// + the IP address listed there (phones often cannot find a bare server name).
# PUBLIC_BASE_URL=

MAX_UPLOAD_MB=25
RM_DIGITS=6
